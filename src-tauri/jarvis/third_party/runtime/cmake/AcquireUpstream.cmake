cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED JARVIS_RUNTIME_SOURCE_CACHE)
  message(FATAL_ERROR "Pass -DJARVIS_RUNTIME_SOURCE_CACHE=<absolute cache directory>")
endif()
if(NOT IS_ABSOLUTE "${JARVIS_RUNTIME_SOURCE_CACHE}")
  message(FATAL_ERROR "JARVIS_RUNTIME_SOURCE_CACHE must be absolute")
endif()

set(revision b9d15b83ee353b2eaeee4d9318c98a35a1347486)
set(archive "${JARVIS_RUNTIME_SOURCE_CACHE}/llama.cpp-omni-${revision}.tar.gz")
set(source_dir "${JARVIS_RUNTIME_SOURCE_CACHE}/llama.cpp-omni-${revision}")
file(MAKE_DIRECTORY "${JARVIS_RUNTIME_SOURCE_CACHE}")
set(expected_hash f8505a9179ff4b8e3ca648c4d462ad46edcc7698507ab3717bc3ee840f45710c)
set(official_url "https://github.com/tc-mb/llama.cpp-omni/archive/${revision}.tar.gz")
set(download_urls "${official_url}")

string(TOLOWER "$ENV{JARVIS_DISABLE_DOWNLOAD_MIRROR}" disable_mirror)
if(NOT disable_mirror MATCHES "^(1|true|yes|on)$")
  if(DEFINED ENV{JARVIS_GITHUB_MIRROR_PREFIX} AND
     NOT "$ENV{JARVIS_GITHUB_MIRROR_PREFIX}" STREQUAL "")
    set(mirror_prefix "$ENV{JARVIS_GITHUB_MIRROR_PREFIX}")
  else()
    set(mirror_prefix "https://gh-proxy.com/")
  endif()
  if(mirror_prefix MATCHES "\\{url\\}")
    string(REPLACE "{url}" "${official_url}" mirror_url "${mirror_prefix}")
  else()
    string(REGEX REPLACE "/+$" "" mirror_prefix "${mirror_prefix}")
    set(mirror_url "${mirror_prefix}/${official_url}")
  endif()
  list(APPEND download_urls "${mirror_url}")
endif()

set(downloaded FALSE)
if(EXISTS "${archive}")
  file(SHA256 "${archive}" cached_hash)
  if(cached_hash STREQUAL expected_hash)
    set(downloaded TRUE)
  else()
    file(REMOVE "${archive}")
  endif()
endif()
set(download_failures "")
if(NOT downloaded)
  foreach(download_url IN LISTS download_urls)
    set(partial "${archive}.partial")
    file(REMOVE "${partial}")
    file(DOWNLOAD "${download_url}" "${partial}"
      TLS_VERIFY ON INACTIVITY_TIMEOUT 60 STATUS download_status)
    list(GET download_status 0 download_code)
    list(GET download_status 1 download_message)
    if(download_code EQUAL 0)
      file(SHA256 "${partial}" actual_hash)
      if(actual_hash STREQUAL expected_hash)
        file(RENAME "${partial}" "${archive}")
        set(downloaded TRUE)
        break()
      endif()
      set(download_message "SHA-256 mismatch")
    endif()
    file(REMOVE "${partial}")
    list(APPEND download_failures "${download_url}: ${download_message}")
    message(WARNING "Pinned runtime download failed from ${download_url}")
  endforeach()
endif()
if(NOT downloaded)
  list(JOIN download_failures "\n" failure_message)
  message(FATAL_ERROR "Pinned runtime download failed from all configured sources:\n${failure_message}")
endif()

if(NOT EXISTS "${source_dir}/CMakeLists.txt")
  file(ARCHIVE_EXTRACT INPUT "${archive}"
       DESTINATION "${JARVIS_RUNTIME_SOURCE_CACHE}")
endif()
if(NOT EXISTS "${source_dir}/LICENSE")
  message(FATAL_ERROR "Pinned runtime archive has an unexpected layout")
endif()

message(STATUS "Verified pinned runtime source: ${source_dir}")
message(STATUS "Configure with -DJARVIS_RUNTIME_UPSTREAM_SOURCE_DIR=${source_dir}")
